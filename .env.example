# Beehiiv credentials used by functions/api/subscribe.js
# Set the real values as environment variables/secrets in the Cloudflare
# Pages dashboard (Settings > Environment variables) — never commit them.
# For local testing with `wrangler pages dev`, copy these into a
# .dev.vars file (already gitignored) instead.

# Account Settings > API Keys > Create API Key
BEEHIIV_API_KEY=your_beehiiv_api_key_here

# Your publication's dashboard URL or Settings page (format: pub_xxxxxxxx)
PUBLICATION_ID=pub_xxxxxxxx
