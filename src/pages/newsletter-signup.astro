---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';
---

<Layout hideHeader={true}>
  <SEO
    slot="head"
    title="Modern Compass Newsletter — One Topic. Four Directions."
    description="Every issue explores one idea across Self, Trust, Character, and Relationships. Once a month."
    canonical="https://themoderncompass.io/newsletter-signup"
    keywords="personal development newsletter, modern compass newsletter, self improvement, character development, relationships growth, monthly newsletter"
    noindex={true}
  />
  <link slot="head" rel="preconnect" href="https://subscribe-forms.beehiiv.com" />

  <!-- Hero Section -->
  <section class="hero">
    <div class="wrap narrow">
      <h1 class="headline">We've all spent too long trying to fix a problem without realizing we were only working on the surface.</h1>
      <p class="subline">Once a month, Modern Compass <span class="gradient-highlight">looks one layer beneath</span> a familiar life challenge to help you see what you may be missing and to make more confident life decisions.</p>

      <div class="built-for">
        <span class="built-for-label">One layer deeper can look like:</span>
        <p class="cycling-line"><span class="cycling-text" id="cyclingText"></span><span class="cursor">|</span></p>
      </div>

      <!-- Subscribe Form -->
      <div class="embed-wrap">
        <script async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="261a3276-40ab-431a-8523-c85bec095b96"></script>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Layout helpers ── */
  .wrap { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
  .wrap.narrow { max-width: 720px; }

  /* ── Hero ── */
  .hero {
    position: relative;
    /* Extra bottom padding gives the graphic's lower half somewhere to
       live beneath the button without bleeding into the footer — see
       the ::before comment below for why it needs that room. */
    padding: 56px 0 280px;
    text-align: center;
    background-color: #fff;
    overflow: hidden;
  }

  /* The graphic's eye sits behind the subscribe button — its bottom half
     mirrors its top half around the button, so the whole composition
     radiates outward from the CTA. It's anchored from the hero's BOTTOM
     edge (where the button always is) rather than centered top-to-bottom,
     because the button's distance from the bottom stays put while its
     distance from the top swings with however many lines the headline/
     rotator wrap to. Width is capped in vw so it can never cause
     horizontal scroll, and height simply follows the image's own aspect
     ratio — nothing here reacts to the hero's content-driven height, so
     resizing the window can't make it "zoom." background-size: contain
     keeps the whole graphic visible instead of cropping it into a square;
     the hero's bottom padding above is sized so the full circle fits
     without overflow:hidden ever actually having to cut into it. */
  .hero::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 296px;
    width: min(620px, 82vw);
    aspect-ratio: 1283 / 1226;
    transform: translate(-50%, 50%);
    background-image: url('/Background.png');
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
    opacity: 0.4;
    z-index: 0;
    pointer-events: none;
  }

  .hero > .wrap {
    position: relative;
    z-index: 1;
  }

  .headline {
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    font-weight: 700;
    line-height: 1.25;
    color: #111;
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }

  .subline {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #444;
    margin: 0 0 16px;
    line-height: 1.5;
  }

  .gradient-highlight {
    display: inline-block;
    font-size: 1.3em;
    font-weight: 800;
    background: linear-gradient(90deg, var(--color-purple, #b324a7), var(--color-blue, #0087c9), var(--color-orange, #f76a3e));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  /* Built-for typewriter */
  .built-for {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin: 0 auto 28px;
  }

  .built-for-label {
    color: #8b5cf6;
    font-weight: 600;
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
  }

  .cycling-line {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    /* Reserve exactly two lines of the cycling text's own size/line-height
       (not the ambient body font-size) so a long entry that wraps never
       shifts the subscribe button — it just has room already waiting. */
    min-height: calc(2 * 1.4 * clamp(1.05rem, 2.2vw, 1.3rem));
  }

  .cycling-text {
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    font-weight: 700;
    color: #111;
    line-height: 1.4;
  }

  .cursor {
    color: #8b5cf6;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  /* Embed */
  .embed-wrap {
    margin: 0 auto 24px;
    width: 100%;
    max-width: 100%;
    min-height: 56px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .embed-wrap > :global(iframe),
  .embed-wrap > :global(div) {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto !important;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .hero {
      padding: 36px 0 200px;
    }

    .hero::before {
      bottom: 216px;
    }

    .cycling-line { max-width: 100%; }
  }
</style>

<script is:inline>
  document.body.classList.add('newsletter-page');

  // Meta Pixel & GA conversion tracking + redirect to thank-you page
  window.addEventListener('message', function(event) {
    if (event.data && typeof event.data === 'string' && event.data.includes('beehiiv')) {
      if (typeof fbq !== 'undefined') {
        fbq('track', 'Lead', { content_name: 'Newsletter Signup', content_category: 'Newsletter', value: 5.00, currency: 'USD' });
      }
      if (typeof gtag !== 'undefined') {
        gtag('event', 'generate_lead', { event_category: 'Newsletter', event_label: 'Newsletter Signup', value: 5.00 });
      }
      // Give the pixel/gtag calls a moment to fire before navigating away.
      setTimeout(function() {
        window.location.href = '/thank-you';
      }, 300);
    }
  });

  // Typewriter animation
  document.addEventListener('DOMContentLoaded', function() {
    const personas = [
      'Dating struggles rooted in worth and confidence',
      'Career confusion that came down to trusting your own judgment',
      'A project delayed for years waiting to feel ready',
      'Relationship friction that began with the loss of common ground',
      'Procrastination that was really anxiety in disguise',
      'Weak boundaries caused by giving trust too freely',
      'Feeling surrounded by people but still not truly known',
      'Inherited expectations mistaken for who you really are'
    ];

    const el = document.getElementById('cyclingText');
    let idx = 0, charIdx = 0, deleting = false;

    function type() {
      const full = personas[idx];
      charIdx = deleting ? charIdx - 1 : charIdx + 1;
      el.textContent = full.substring(0, charIdx);

      let delay = deleting ? 15 : 35;
      if (!deleting && charIdx === full.length) { delay = 2800; deleting = true; }
      else if (deleting && charIdx === 0) { deleting = false; idx = (idx + 1) % personas.length; delay = 500; }

      setTimeout(type, delay);
    }
    type();
  });
</script>
