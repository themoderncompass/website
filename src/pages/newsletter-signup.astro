---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';
import NewsletterLanding from '../components/NewsletterLanding.astro';
---

<Layout hideHeader={true} fullWidth={true}>
  <SEO
    slot="head"
    title="Modern Compass Newsletter — One Layer Beneath the Obvious"
    description="Practical perspectives to help you see what’s beneath the surface before deciding what comes next. Every third Friday, free in your inbox."
    canonical="https://themoderncompass.io/newsletter-signup"
    keywords="personal development newsletter, modern compass newsletter, self improvement, decision making, character development, relationships growth, monthly newsletter"
    noindex={true}
  />
  <NewsletterLanding />
</Layout>
