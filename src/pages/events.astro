---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';
---
<Layout>
  <SEO
    slot="head"
    title="Events | Modern Compass"
    description="No Modern Compass events are scheduled right now."
    canonical="https://themoderncompass.io/events"
    keywords="Modern Compass events"
  />
  <section class="events">
    <h1>Events</h1>
    <p class="intro">No events scheduled right now.</p>
  </section>
</Layout>

<style>
  .events {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .events h1 {
    font-size: 2rem;
    color: var(--primary-color);
    margin-bottom: 0.5rem;
  }

  .intro {
    max-width: 700px;
    font-size: 1rem;
    line-height: 1.6;
  }
</style>
