---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';
---

<Layout>
  <SEO
    slot="head"
    title="Modern Compass Newsletter — One Topic. Four Directions."
    description="Every issue explores one idea across Self, Trust, Character, and Relationships. Once a month."
    canonical="https://themoderncompass.io/newsletter"
    keywords="personal development newsletter, modern compass newsletter, self improvement, character development, relationships growth, monthly newsletter"
  />
  <link slot="head" rel="preconnect" href="https://subscribe-forms.beehiiv.com" />

  <!-- Hero Section -->
  <section class="hero">
    <div class="wrap narrow">
      <h1 class="headline">We've all spent too long trying to fix a problem without realizing we were only working on the surface.</h1>
      <p class="subline">Once a month, Modern Compass <span class="gradient-highlight">looks one layer beneath</span> a familiar life challenge to help you see what you may be missing and to make more confident life decisions.</p>

      <div class="built-for">
        <span class="built-for-label">Built for</span>
        <span class="arrow">→</span>
        <span class="cycling-text" id="cyclingText"></span><span class="cursor">|</span>
      </div>

      <!-- Subscribe Form -->
      <div class="embed-wrap">
        <script async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="261a3276-40ab-431a-8523-c85bec095b96"></script>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Layout helpers ── */
  .wrap { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
  .wrap.narrow { max-width: 720px; }

  /* ── Hero ── */
  .hero {
    padding: 56px 0 40px;
    text-align: center;
    background-image: linear-gradient(rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.82)), url('/Background.png');
    background-position: center center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .headline {
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    font-weight: 700;
    line-height: 1.25;
    color: #111;
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }

  .subline {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #444;
    margin: 0 0 16px;
    line-height: 1.5;
  }

  .gradient-highlight {
    display: inline-block;
    font-size: 1.3em;
    font-weight: 800;
    background: linear-gradient(90deg, var(--color-purple, #b324a7), var(--color-blue, #0087c9), var(--color-orange, #f76a3e));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  /* Built-for typewriter */
  .built-for {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: clamp(1rem, 2vw, 1.3rem);
    font-weight: 600;
    color: #111;
    margin: 0 0 28px;
    flex-wrap: nowrap;
  }

  .built-for-label {
    color: #8b5cf6;
    white-space: nowrap;
  }

  .arrow { color: #8b5cf6; }

  .cycling-text {
    display: inline-block;
    white-space: nowrap;
  }

  .cursor {
    color: #8b5cf6;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  /* Embed */
  .embed-wrap {
    margin: 0 auto 24px;
    width: 100%;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .embed-wrap > :global(iframe),
  .embed-wrap > :global(div) {
    margin: 0 auto;
    width: 100% !important;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .hero { padding: 36px 0 28px; }

    .built-for {
      font-size: 0.95rem;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>

<script is:inline>
  document.body.classList.add('newsletter-page');

  // Meta Pixel & GA conversion tracking + redirect to thank-you page
  window.addEventListener('message', function(event) {
    if (event.data && typeof event.data === 'string' && event.data.includes('beehiiv')) {
      if (typeof fbq !== 'undefined') {
        fbq('track', 'Lead', { content_name: 'Newsletter Signup', content_category: 'Newsletter', value: 5.00, currency: 'USD' });
      }
      if (typeof gtag !== 'undefined') {
        gtag('event', 'generate_lead', { event_category: 'Newsletter', event_label: 'Newsletter Signup', value: 5.00 });
      }
      // Give the pixel/gtag calls a moment to fire before navigating away.
      setTimeout(function() {
        window.location.href = '/thank-you';
      }, 300);
    }
  });

  // Typewriter animation
  document.addEventListener('DOMContentLoaded', function() {
    const personas = [
      'Lost twenty-somethings',
      'Wandering thirty-somethings',
      'Searching forty-somethings',
      'High performers, low clarity',
      'Overthinkers who under-act',
      'Comfortable but restless',
      'Stuck on surface-level problems',
      'Ready to look one layer deeper'
    ];

    const el = document.getElementById('cyclingText');
    let idx = 0, charIdx = 0, deleting = false;

    function type() {
      const full = personas[idx];
      charIdx = deleting ? charIdx - 1 : charIdx + 1;
      el.textContent = full.substring(0, charIdx);

      let delay = deleting ? 30 : 60;
      if (!deleting && charIdx === full.length) { delay = 2000; deleting = true; }
      else if (deleting && charIdx === 0) { deleting = false; idx = (idx + 1) % personas.length; delay = 500; }

      setTimeout(type, delay);
    }
    type();
  });
</script>
