---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';
---

<Layout>
  <SEO
    slot="head"
    title="Modern Compass Newsletter — One Layer Beneath the Obvious"
    description="The Modern Compass newsletter looks one layer beneath a familiar life challenge to show a new perspective and improve confidence in decision making."
    canonical="https://themoderncompass.io/newsletter"
    keywords="personal development newsletter, modern compass newsletter, self improvement, decision making, character development, relationships growth, monthly newsletter"
  />
  <link slot="head" rel="preconnect" href="https://subscribe-forms.beehiiv.com" />
  <!-- The signup form is the whole point of this page — prioritize
       fetching its script so it's ready as early as possible, without
       touching the DOM/CSS at all. -->
  <link slot="head" rel="preload" as="script" fetchpriority="high" href="https://subscribe-forms.beehiiv.com/v3/loader.js" />

  <!-- Hero background is the LCP element on this page — preload it with
       fetchpriority high so the browser fetches it from the HTML scan
       instead of discovering it only after CSS is parsed. Never lazy-load
       this. `media` picks the one matching variant per viewport so only
       one file downloads. -->
  <link slot="head" rel="preload" as="image" type="image/webp" fetchpriority="high" media="(max-width: 640px)" href="/background-mobile.webp" />
  <link slot="head" rel="preload" as="image" type="image/webp" fetchpriority="high" media="(min-width: 641px)" href="/background-desktop.webp" />

  <!-- Hero Section -->
  <section class="hero">
    <div class="wrap narrow">
      <h1 class="headline">We've all spent too long trying to fix the wrong problem.</h1>
      <p class="subline"><span class="subline-text">The Modern Compass newsletter <span class="gradient-highlight">looks one layer beneath</span> a familiar life challenge to show a new perspective and improve confidence in decision making.</span></p>

      <div class="built-for">
        <span class="built-for-label">One layer deeper, IRL:</span>
        <p class="cycling-line"><span class="cycling-text" id="cyclingText"></span><span class="cursor">|</span></p>
      </div>

      <!-- Subscribe Form -->
      <div class="embed-wrap">
        <script async fetchpriority="high" src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="261a3276-40ab-431a-8523-c85bec095b96"></script>
      </div>

      <!-- Credibility -->
      <p class="credibility">I've spent more than a decade working through ambiguous problems where the obvious answer is rarely the whole answer. Modern Compass grew from realizing I'd spent years doing the same thing in my own life: trying to fix what I could see instead of looking at what was underneath it.<span class="credibility-attribution">— Josh Imholte, Founder</span></p>
    </div>
  </section>

</Layout>

<style>
  /* ── Layout helpers ── */
  .wrap { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
  .wrap.narrow { max-width: 720px; }

  /* ── Hero ── */
  .hero {
    position: relative;
    /* Extra bottom padding gives the graphic's lower half somewhere to
       live beneath the rotator without bleeding into the footer — see
       the ::before comment below for why it needs that room. */
    padding: 56px 0 64px;
    text-align: center;
    background-color: #fff;
    overflow: hidden;
  }

  /* The graphic's eye sits behind the rotator (the "One layer deeper can
     look like:" line), so the whole composition radiates outward from
     that hook line instead of the button below it. It's a pseudo-element
     of .built-for itself (not .hero) so top/left: 50% + translate(-50%,-50%)
     center it on the rotator regardless of how many lines the headline/
     subline above it wrap to. Sized as large as the layout allows —
     hero's overflow:hidden clips anything that reaches past the top of
     the hero section, which is exactly where the header/nav sits, so the
     graphic grows until the nav cuts it off rather than stopping short. */
  .built-for::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(560px, 117vw);
    aspect-ratio: 1283 / 1226;
    transform: translate(-50%, -50%);
    background-image: url('/background-desktop.webp');
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
    opacity: 0.4;
    z-index: -1;
    pointer-events: none;
  }

  .hero > .wrap {
    position: relative;
    z-index: 1;
  }

  .headline {
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    font-weight: 700;
    line-height: 1.25;
    color: #111;
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }

  .subline {
    margin: 0 0 16px;
  }

  /* A translucent, rounded backdrop hugging just the text (not a hard
     white block spanning the hero) so the graphic still reads through
     around it while the text itself gets enough contrast to read easily.
     box-decoration-break keeps the rounded corners/padding correct on
     each wrapped line instead of only the first/last. */
  .subline-text {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #333;
    line-height: 1.6;
    background: rgba(255, 255, 255, 0.92);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding: 0.2em 0.5em;
    border-radius: 6px;
  }

  .gradient-highlight {
    display: inline-block;
    font-size: 1.3em;
    font-weight: 800;
    background: linear-gradient(90deg, var(--color-purple, #b324a7), var(--color-blue, #0087c9), var(--color-orange, #f76a3e));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  /* Built-for typewriter */
  .built-for {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin: 0 auto 28px;
  }

  .built-for-label {
    color: #8b5cf6;
    font-weight: 600;
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
  }

  .cycling-line {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    /* Reserve exactly two lines of the cycling text's own size/line-height
       (not the ambient body font-size) so a long entry that wraps never
       shifts the subscribe button — it just has room already waiting. */
    min-height: calc(2 * 1.4 * clamp(1.05rem, 2.2vw, 1.3rem));
  }

  .cycling-text {
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    font-weight: 700;
    color: #111;
    line-height: 1.4;
  }

  .cursor {
    color: #8b5cf6;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  /* Embed */
  .embed-wrap {
    margin: 0 auto 24px;
    width: 100%;
    max-width: 100%;
    min-height: 56px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .embed-wrap > :global(iframe),
  .embed-wrap > :global(div) {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto !important;
  }

  /* Founder credibility line. Pushed well clear of the background graphic's
     lower edge (the graphic is centered on .built-for and extends roughly
     half its own height below it) so the card sits on clean white instead
     of overlapping the art. Styled as a distinct pull-quote card — a
     brand-gradient accent bar (via ::before, so its corners can stay
     independent of the card's own radius) + blur + a tinted shadow — so it
     reads as a polished personal aside, not more hero copy. */
  .credibility {
    position: relative;
    max-width: 560px;
    margin: 64px auto 0;
    text-align: left;
    font-size: clamp(0.88rem, 1.6vw, 0.98rem);
    line-height: 1.6;
    color: #333;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(248, 244, 255, 0.94));
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-radius: 12px;
    padding: 18px 24px 18px 28px;
    box-shadow: 0 16px 36px rgba(139, 92, 246, 0.16), 0 2px 10px rgba(0, 0, 0, 0.06);
  }

  .credibility::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    border-radius: 12px 0 0 12px;
    background: linear-gradient(180deg, var(--color-purple, #b324a7), var(--color-blue, #0087c9), var(--color-orange, #f76a3e));
  }

  .credibility-attribution {
    display: block;
    margin-top: 8px;
    font-style: normal;
    font-weight: 600;
    font-size: 0.85em;
    color: #8b5cf6;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .hero {
      padding: 36px 0 48px;
    }

    .built-for::before {
      width: min(480px, 122vw);
      background-image: url('/background-mobile.webp');
    }

    .cycling-line {
      max-width: 100%;
      /* Mobile wraps more of these entries onto a 3rd line, so reserve
         3 lines here instead of desktop's 2 — otherwise a long entry
         still pushes the subscribe button down when it wraps further
         than the 2-line allowance. */
      min-height: calc(3 * 1.4 * clamp(1.05rem, 2.2vw, 1.3rem));
    }
  }
</style>

<script is:inline>
  document.body.classList.add('newsletter-page');

  // Meta Pixel & GA conversion tracking + redirect to thank-you page
  window.addEventListener('message', function(event) {
    if (event.data && typeof event.data === 'string' && event.data.includes('beehiiv')) {
      if (typeof fbq !== 'undefined') {
        fbq('track', 'Lead', { content_name: 'Newsletter Signup', content_category: 'Newsletter', value: 5.00, currency: 'USD' });
      }
      if (typeof gtag !== 'undefined') {
        gtag('event', 'generate_lead', { event_category: 'Newsletter', event_label: 'Newsletter Signup', value: 5.00 });
      }
      // Give the pixel/gtag calls a moment to fire before navigating away.
      setTimeout(function() {
        window.location.href = '/thank-you';
      }, 300);
    }
  });

  // Typewriter animation
  document.addEventListener('DOMContentLoaded', function() {
    const personas = [
      'Dating life improved once you realized the importance of self-worth and did something about your anxiety',
      'A career pivot when you recognized how far character could take you',
      'The book got written once you trusted you had something to say',
      'That project finally started when you realized self-control was all you ever needed'
    ];

    const el = document.getElementById('cyclingText');
    let idx = 0, charIdx = 0, deleting = false;

    function type() {
      const full = personas[idx];
      charIdx = deleting ? charIdx - 1 : charIdx + 1;
      el.textContent = full.substring(0, charIdx);

      let delay = deleting ? 15 : 35;
      if (!deleting && charIdx === full.length) { delay = 2800; deleting = true; }
      else if (deleting && charIdx === 0) { deleting = false; idx = (idx + 1) % personas.length; delay = 500; }

      setTimeout(type, delay);
    }
    type();
  });
</script>
