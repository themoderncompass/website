---
---

<!-- Hero Section -->
<section class="hero">
  <div class="wrap narrow">
    <h1 class="headline">We've all spent too long trying to fix the wrong problem.</h1>
    <p class="subline"><span class="subline-text">The Modern Compass newsletter <span class="gradient-highlight">looks one layer beneath</span> a familiar life challenge to show a new perspective to better inform what you do next.</span></p>

    <div class="built-for">
      <span class="built-for-label">One layer deeper, IRL:</span>
      <p class="cycling-line"><span class="cycling-text" id="cyclingText"></span><span class="cursor">|</span></p>
    </div>

    <!-- Subscribe Form -->
    <form id="subscribeForm" class="subscribe-form" novalidate>
      <div class="honeypot">
        <label for="website">Leave this field blank</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>
      <div class="form-row">
        <input
          type="email"
          id="email"
          name="email"
          class="email-input"
          placeholder="Enter your email"
          required
          autocomplete="email"
          aria-label="Email address"
        />
        <button type="submit" id="submitBtn" class="submit-btn">
          <span class="btn-label">Onward</span>
        </button>
      </div>
      <p id="formError" class="form-error" role="alert" hidden></p>
    </form>

    <!-- Credibility -->
    <p class="credibility">I've spent more than a decade working through ambiguous problems where the obvious answer is rarely the whole answer. Modern Compass grew from realizing I'd spent years doing the same thing in my own life: trying to fix what I could see instead of looking at what was underneath it.<span class="credibility-attribution">— Josh Imholte, Founder</span></p>
  </div>
</section>

<style>
  /* ── Layout helpers ── */
  .wrap { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
  .wrap.narrow { max-width: 720px; }

  /* ── Hero ── */
  .hero {
    position: relative;
    padding: 56px 0 64px;
    text-align: center;
    background-color: #fff;
  }

  .hero > .wrap {
    position: relative;
    z-index: 1;
  }

  .headline {
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    font-weight: 700;
    line-height: 1.25;
    color: #111;
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }

  .subline {
    margin: 0 0 16px;
  }

  /* A translucent, rounded backdrop hugging just the text (not a hard
     white block spanning the hero) so the graphic still reads through
     around it while the text itself gets enough contrast to read easily.
     box-decoration-break keeps the rounded corners/padding correct on
     each wrapped line instead of only the first/last. */
  .subline-text {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #333;
    line-height: 1.6;
    background: rgba(255, 255, 255, 0.92);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding: 0.2em 0.5em;
    border-radius: 6px;
  }

  .gradient-highlight {
    display: inline-block;
    font-size: 1.3em;
    font-weight: 800;
    background: linear-gradient(90deg, var(--color-purple, #b324a7), var(--color-blue, #0087c9), var(--color-orange, #f76a3e));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  /* Built-for typewriter */
  .built-for {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin: 0 auto 28px;
  }

  .built-for-label {
    color: #8b5cf6;
    font-weight: 600;
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
  }

  .cycling-line {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    /* Reserve exactly two lines of the cycling text's own size/line-height
       (not the ambient body font-size) so a long entry that wraps never
       shifts the subscribe button — it just has room already waiting. */
    min-height: calc(2 * 1.4 * clamp(1.05rem, 2.2vw, 1.3rem));
  }

  .cycling-text {
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    font-weight: 700;
    color: #111;
    line-height: 1.4;
  }

  .cursor {
    color: #8b5cf6;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  /* Subscribe form */
  .subscribe-form {
    margin: 0 auto 24px;
    width: 100%;
    max-width: 480px;
  }

  /* Honeypot — hidden from real visitors, still reachable by bots that
     fill in every field blindly. Off-screen rather than display:none so
     it isn't skipped by autofill/bot heuristics that check visibility. */
  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .form-row {
    display: flex;
    gap: 10px;
  }

  .email-input {
    flex: 1;
    min-width: 0;
    padding: 14px 16px;
    font-size: 1rem;
    font-family: inherit;
    color: #111;
    background: #fff;
    border: 2px solid #e5e7eb;
    border-radius: 10px;
    outline: none;
    transition: border-color 0.15s ease;
  }

  .email-input:focus {
    border-color: #8b5cf6;
  }

  .submit-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #8b5cf6, #6d28d9);
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    padding: 14px 28px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
    box-shadow: 0 4px 14px rgba(139, 92, 246, 0.35);
  }

  .submit-btn:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(139, 92, 246, 0.45);
  }

  .submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  .form-error {
    margin: 10px 0 0;
    color: #dc2626;
    font-size: 0.9rem;
    text-align: left;
  }

  @media (max-width: 480px) {
    .form-row {
      flex-direction: column;
    }

    .submit-btn {
      width: 100%;
    }
  }

  /* Founder credibility line, styled as a distinct pull-quote card — a
     brand-gradient accent bar (via ::before, so its corners can stay
     independent of the card's own radius) + blur + a tinted shadow — so it
     reads as a polished personal aside, not more hero copy. */
  .credibility {
    position: relative;
    max-width: 560px;
    margin: 32px auto 0;
    text-align: left;
    font-size: clamp(0.88rem, 1.6vw, 0.98rem);
    line-height: 1.6;
    color: #333;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(248, 244, 255, 0.94));
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-radius: 12px;
    padding: 18px 24px 18px 28px;
    box-shadow: 0 16px 36px rgba(139, 92, 246, 0.16), 0 2px 10px rgba(0, 0, 0, 0.06);
  }

  .credibility::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    border-radius: 12px 0 0 12px;
    background: linear-gradient(180deg, var(--color-purple, #b324a7), var(--color-blue, #0087c9), var(--color-orange, #f76a3e));
  }

  .credibility-attribution {
    display: block;
    margin-top: 8px;
    font-style: normal;
    font-weight: 600;
    font-size: 0.85em;
    color: #8b5cf6;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .hero {
      padding: 36px 0 48px;
    }

    .cycling-line {
      max-width: 100%;
      /* Mobile wraps more of these entries onto a 3rd line, so reserve
         3 lines here instead of desktop's 2 — otherwise a long entry
         still pushes the subscribe button down when it wraps further
         than the 2-line allowance. */
      min-height: calc(3 * 1.4 * clamp(1.05rem, 2.2vw, 1.3rem));
    }
  }
</style>

<script is:inline>
  document.body.classList.add('newsletter-page');

  // Newsletter subscribe form: posts to our own /api/subscribe function
  // (which talks to beehiiv server-side), fires conversion tracking, then
  // redirects to the thank-you page.
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('subscribeForm');
    if (!form) return;

    const emailInput = document.getElementById('email');
    const honeypot = document.getElementById('website');
    const submitBtn = document.getElementById('submitBtn');
    const btnLabel = submitBtn.querySelector('.btn-label');
    const errorEl = document.getElementById('formError');
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    form.addEventListener('submit', async function(event) {
      event.preventDefault();
      errorEl.hidden = true;

      // Bots that fill in every field land here; drop them silently.
      if (honeypot.value) return;

      const email = emailInput.value.trim();
      if (!EMAIL_RE.test(email)) {
        errorEl.textContent = 'Please enter a valid email address.';
        errorEl.hidden = false;
        return;
      }

      submitBtn.disabled = true;
      btnLabel.textContent = 'Subscribing…';

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email }),
        });

        const data = await res.json().catch(function() { return {}; });
        if (!res.ok) {
          throw new Error(data.error || 'Something went wrong. Please try again.');
        }

        if (typeof fbq !== 'undefined') {
          fbq('track', 'Lead', { content_name: 'Newsletter Signup', content_category: 'Newsletter', value: 5.00, currency: 'USD' });
        }
        if (typeof gtag !== 'undefined') {
          gtag('event', 'generate_lead', { event_category: 'Newsletter', event_label: 'Newsletter Signup', value: 5.00 });
        }

        // Give the pixel/gtag calls a moment to fire before navigating away.
        setTimeout(function() {
          window.location.href = '/thank-you';
        }, 300);
      } catch (err) {
        errorEl.textContent = err.message || 'Something went wrong. Please try again.';
        errorEl.hidden = false;
        submitBtn.disabled = false;
        btnLabel.textContent = 'Onward';
      }
    });
  });

  // Typewriter animation
  document.addEventListener('DOMContentLoaded', function() {
    const personas = [
      'Dating life improved once you realized the importance of self-worth and did something about your anxiety',
      'A career pivot when you recognized how far character could take you',
      'The book got written once you trusted you had something to say',
      'That project finally started when you realized self-control was all you ever needed'
    ];

    const el = document.getElementById('cyclingText');
    let idx = 0, charIdx = 0, deleting = false;

    function type() {
      const full = personas[idx];
      charIdx = deleting ? charIdx - 1 : charIdx + 1;
      el.textContent = full.substring(0, charIdx);

      let delay = deleting ? 15 : 35;
      if (!deleting && charIdx === full.length) { delay = 2800; deleting = true; }
      else if (deleting && charIdx === 0) { deleting = false; idx = (idx + 1) % personas.length; delay = 500; }

      setTimeout(type, delay);
    }
    type();
  });
</script>
