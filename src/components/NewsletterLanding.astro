:9px 0 0}.phone-stage{display:flex;flex-direction:column;align-items:center;gap:24px;padding:0 16px}.iphone{position:relative;width:214px;height:443px;background:#171719;border:2px solid #8d8b90;border-radius:35px;padding:6px;transform:rotate(8deg);box-shadow:14px 20px 40px #47365b24,0 2px 3px #27212b44}.iphone:before{content:'';position:absolute;left:-4px;top:79px;width:3px;height:41px;border-radius:2px;background:#838087;box-shadow:0 51px #838087}.iphone:after{content:'';position:absolute;right:-4px;top:111px;width:3px;height:56px;border-radius:2px;background:#838087}.screen{height:100%;border-radius:27px;background:white;overflow:hidden;position:relative}.status{position:absolute;inset:0 0 auto;z-index:3;height:29px;display:flex;align-items:center;justify-content:space-between;background:#fff;padding:0 14px;font:600 8px -apple-system,sans-serif}.island{position:absolute;left:50%;top:7px;transform:translateX(-50%);width:60px;height:17px;background:#111;border-radius:15px}.status-icons{letter-spacing:1px;font-size:7px}.screen-scroll{position:absolute;top:29px;bottom:13px;left:0;right:0;overflow:hidden;background:#fff}.newsletter-capture{display:block;width:100%;height:auto;animation:newsletter-scroll 56s linear infinite;will-change:transform}.iphone:hover .newsletter-capture,.iphone.paused .newsletter-capture{animation-play-state:paused}.home{position:absolute;bottom:5px;width:65px;height:3px;background:#171719;border-radius:4px;left:50%;transform:translateX(-50%);z-index:3}.phone-control{background:none;border:0;color:#8a7b99;font-size:10px;cursor:pointer;padding:5px}.phone-control:hover{color:#6d28d9}@keyframes newsletter-scroll{0%,8%{transform:translateY(-65px)}88%,100%{transform:translateY(-1900px)}}
