  @media(max-width:540px){.nav-links{display:none}.hero-grid{grid-template-columns:1fr;gap:36px}.hero h1{font-size:49px;max-width:360px}.hero-prose{font-size:16px}.signup-row{flex-direction:row}.phone-stage{padding-bottom:8px}.iphone{width:190px;height:394px}.benefits-section{padding:46px 0}.section-title{font-size:29px}.benefits,.issues{grid-template-columns:1fr}.paper{display:block;padding:26px}.headshot{float:left;margin:0 17px 12px 0;width:70px;height:70px}.paper p{clear:both}.note-label{margin-top:19px}.note-section{padding:43px 0}.top-section{padding-bottom:48px}.footer .wrap{display:block}.footer span{display:block;margin-top:5px}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.newsletter-capture{animation:none;transform:translateY(-65px)}.issue{transition:none}}
